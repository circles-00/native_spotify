set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXECUTABLE)

find_program(ZIG_EXECUTABLE zig REQUIRED)
set(CMAKE_C_COMPILER "${ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 "cc -target x86_64-windows-gnu")
find_program(CMAKE_AR NAMES llvm-ar ar REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib ranlib REQUIRED)
